{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs:check": "node scripts/check-docs.mjs",
    "contracts:check": "node scripts/check-site-contracts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:cms": "node --test tests/cms/*.test.mjs",
    "test:cms:db": "node --test tests/cms-db/*.test.mjs",
    "test:cms:docker": "node scripts/test-cms-docker.mjs",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm docs:check && pnpm contracts:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:cms",
    "validate": "pnpm check && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.25",
    "motion": "^12.41.0",
    "next": "16.2.9",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}

{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "new:blog": "node scripts/new-post.mjs blog",
    "new:leetcode": "node scripts/new-post.mjs leetcode",
    "content:check": "node scripts/check-content.mjs",
    "test:content": "node --test tests/content/*.test.mjs",
    "test:content:browser": "node scripts/test-content-browser.mjs",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "docs:check": "node scripts/check-docs.mjs",
    "contracts:check": "node scripts/check-site-contracts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "workflow": "node scripts/task-workflow.mjs",
    "test:workflow": "node --test tests/workflow/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm content:check && pnpm test:content && pnpm docs:check && pnpm contracts:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:workflow",
    "validate": "pnpm check && pnpm build"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}

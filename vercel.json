{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "scripts/install-pandoc.sh",
  "buildCommand": "PATH=\"$PWD/.pandoc/bin:$PATH\" ./build.sh",
  "outputDirectory": "out",
  "functions": {
    "api/comments.mjs": {
      "includeFiles": "content/blog/*/index.md",
      "excludeFiles": "{.pandoc/**,out/**,public/**}"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:collection(blog|leetcode|changelog|books)/page",
      "has": [
        { "type": "query", "key": "page", "value": "0*(?<n>[2-9]|[1-9]\\d+)" }
      ],
      "destination": "/:collection/page/:n",
      "permanent": false
    },
    {
      "source": "/:collection(blog|leetcode|changelog|books)/page",
      "destination": "/:collection",
      "permanent": false
    },
    { "source": "/blog.html", "destination": "/blog" },
    { "source": "/leetcode.html", "destination": "/leetcode" },
    { "source": "/changelog.html", "destination": "/changelog" },
    {
      "source": "/blog/group_theory.html",
      "destination": "/blog/group-theory"
    },
    {
      "source": "/blog/uncompetitively_competing_in_competitive_programming.html",
      "destination": "/blog/uncompetitively-competing-in-competitive-programming"
    },
    {
      "source": "/blog/sightseeing_the_sea_of_c\\+\\+_1.html",
      "destination": "/blog/sightseeing-the-sea-of-cpp-1"
    },
    {
      "source": "/leetcode/:date(\\d{4}-\\d{2}-\\d{2}).html",
      "destination": "/leetcode/:date"
    },
    {
      "source": "/images/eric_photo_2.jpg",
      "destination": "/photos/parable-house.jpg"
    }
  ],
  "headers": [
    {
      "source": "/birthday-2026",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/birthday-2026.ics",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" }
      ]
    },
    {
      "source": "/changelog.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ]
}
